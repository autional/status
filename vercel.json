{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @autional/status-page... build",
  "outputDirectory": "apps/status-page/dist",
  "rewrites": [
    {
      "source": "/bff/:path*",
      "destination": "https://api.autional.cn/bff/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.autional.cn/api/v1/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://api.autional.cn/oauth/:path*"
    },
    {
      "source": "/tenant/:path*",
      "destination": "https://api.autional.cn/tenant/:path*"
    },
    {
      "source": "/ready",
      "destination": "https://api.autional.cn/ready"
    },
    {
      "source": "/feed.xml",
      "destination": "https://api.autional.cn/bff/status/api/v1/status/rss"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
